<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.icg-software</groupId>
        <artifactId>osgi-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <groupId>org.sodeac</groupId>
    <artifactId>org.sodeac.common</artifactId>
    <version>2.0.0-SNAPSHOT</version>

    <name>Sodeac Common</name>
    <description>Core framework for sodeac project</description>
    <packaging>bundle</packaging>

    <dependencies>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.5</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.json</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- FIXME: Remove: Transfer UNIT tests to junit 5 -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.sql</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.*</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/java</directory>
                <includes>
                    <include>**/*.sql</include>
                </includes>
            </testResource>
            <testResource>
                <directory>src/test/resources</directory>
                <includes>
                    <include>**/*.*</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Export-Package>
                            org.sodeac.common;version="${project.version}",
                            org.sodeac.common.annotation;version="${project.version}",
                            org.sodeac.common.expression;version="${project.version}",
                            org.sodeac.common.snapdeque;version="${project.version}",
                            org.sodeac.common.function;version="${project.version}",
                            org.sodeac.common.typedtree*;version="${project.version}",
                            org.sodeac.common.model*;version="${project.version}",
                            org.sodeac.common.xuri;version="${project.version}",
                            org.sodeac.common.xuri.ldapfilter;version="${project.version}",
                            org.sodeac.common.xuri.json;version="${project.version}",
                            org.sodeac.common.message;version="${project.version}",
                            org.sodeac.common.message.dispatcher.api;version="${project.version}",
                            org.sodeac.common.message.dispatcher.setup;version="${project.version}",
                            org.sodeac.common.message.service.api;version="${project.version}",
                            org.sodeac.common.local.service.annotation;version="${project.version}",
                            org.sodeac.common.local.service.api;version="${project.version}",
                            org.sodeac.common.misc;version="${project.version}",
                            org.sodeac.common.synchronization;version="${project.version}",
                            org.sodeac.common.jdbc;version="${project.version}",
                            org.sodeac.common.jdbc.schemax;version="${project.version}"
                        </Export-Package>

                        <Private-Package>
                            org.sodeac.common.message.dispatcher.impl,
                            org.sodeac.common.message.dispatcher.components,
                            org.sodeac.common.message.service.impl,
                            <!-- org.sodeac.common.local.service.impl, -->
                            org.sodeac.common.jdbc.impl,
                            org.sodeac.common.impl
                        </Private-Package>

                        <Import-Package>
                            org.slf4j;version="[2,3)";resolution:=optional,
                            jakarta.xml.bind.annotation;version="[4,5)";resolution:=optional,
                            org.postgresql.*;resolution:=optional;version=!,
                            jakarta.json;version="[2,3)";resolution:=optional,
                            <!-- jakarta.json.stream;version="[2,3)";resolution:=optional, -->
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>

